local function AddToggle(name, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.Position = UDim2.new(0, 0, 0, #ButtonContainer:GetChildren() * 32)
    btn.BackgroundColor3 = default and Color3.fromRGB(130, 20, 200) or Color3.fromRGB(40, 40, 40)
    btn.Text = name .. (default and " [ON]" or " [OFF]")
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.Parent = ButtonContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(130, 20, 200) or Color3.fromRGB(40, 40, 40)
        btn.Text = name .. (state and " [ON]" or " [OFF]")
        callback(state)
    end)
    return btn
end

local function AddSlider(name, minVal, maxVal, default, callback)
    local slider = Instance.new("TextButton")
    slider.Size = UDim2.new(1, 0, 0, 28)
    slider.Position = UDim2.new(0, 0, 0, #ButtonContainer:GetChildren() * 32)
    slider.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    slider.Text = name .. ": " .. tostring(default)
    slider.TextColor3 = Color3.new(1, 1, 1)
    slider.Font = Enum.Font.Gotham
    slider.TextSize = 13
    slider.BorderSizePixel = 0
    slider.Parent = ButtonContainer
    Instance.new("UICorner", slider).CornerRadius = UDim.new(0, 5)
    local value = default
    slider.MouseButton1Click:Connect(function()
        value = value + 0.1
        if value > maxVal then value = minVal end
        slider.Text = name .. ": " .. string.format("%.1f", value)
        callback(value)
    end)
    return slider
end

