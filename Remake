-- ESP рендер
RunService.RenderStepped:Connect(function()
    if not espEnabled then
        for _, esp in ipairs(espList) do
            esp.box.Visible = false
            esp.nameTag.Visible = false
            esp.infoTag.Visible = false
        end
        return
    end

    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                table.insert(targets, {character = plr.Character, hum = hum, root = root, name = plr.Name})
            end
        end
    end

    for i = #espList, 1, -1 do
        if not table.find(targets, espList[i].target) then
            espList[i].box:Remove()
            espList[i].nameTag:Remove()
            espList[i].infoTag:Remove()
            table.remove(espList, i)
        end
    end

    for _, t in ipairs(targets) do
        local found = false
        for _, esp in ipairs(espList) do
            if esp.target == t then found = true break end
        end
        if not found then
            table.insert(espList, createESP(t))
        end
    end

    for _, esp in ipairs(espList) do
        local t = esp.target
        if t.root and t.hum and t.hum.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(t.root.Position)
            if onScreen then
                local dist = (t.root.Position - Camera.CFrame.Position).Magnitude
                local scale = 1 / (dist * math.tan(math.rad(Camera.FieldOfView / 2)) * 2)
                local size = Vector2.new(150 * scale, 200 * scale)
                local boxPos = Vector2.new(pos.X - size.X/2, pos.Y - size.Y/2)
                esp.box.Size = size
                esp.box.Position = boxPos
                esp.box.Visible = true
                esp.nameTag.Text = t.name
                esp.nameTag.Position = Vector2.new(pos.X, boxPos.Y - 15)
                esp.nameTag.Visible = true
                local stamina = t.hum:FindFirstChild("Stamina") or t.hum:FindFirstChild("StaminaValue")
                local staminaText = stamina and ("Stamina: " .. math.floor(stamina.Value)) or ""
                esp.infoTag.Text = "HP: " .. math.floor(t.hum.Health) .. " | " .. staminaText .. " | " .. math.floor(dist) .. "m"
                esp.infoTag.Position = Vector2.new(pos.X, boxPos.Y + size.Y + 5)
                esp.infoTag.Visible = true
            else
                esp.box.Visible = false
                esp.nameTag.Visible = false
                esp.infoTag.Visible = false
            end
        else
            esp.box.Visible = false
            esp.nameTag.Visible = false
            esp.infoTag.Visible = false
        end
    end
end)

