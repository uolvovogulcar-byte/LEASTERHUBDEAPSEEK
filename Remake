-- Авто-комбо с реалистичной паузой и промахами
local AutoM1 = false
local comboStep = 0
local lastHit = 0

local function doCombo()
    if not AutoM1 then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local now = tick()
    -- Рандомная задержка между комбинациями: от 0.6 до 2.0 сек
    local nextTime = lastHit + (comboStep == 0 and math.random(60, 200)/100 or (comboStep == 1 and 0.12 or 0.35))
    if now < nextTime then return end

    -- Проверка: есть ли враг рядом
    local myRoot = char.HumanoidRootPart
    local target = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
            if dist <= 15 then
                target = plr.Character
                break
            end
        end
    end
    if not target then
        comboStep = 0
        return
    end

    -- Иногда пропускаем удар (10% шанс)
    if math.random(1,10) == 1 then
        comboStep = 0
        lastHit = now + 0.2
        return
    end

    -- Выполняем удар в зависимости от шага комбо
    if comboStep == 0 or comboStep == 1 then
        VIM:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        wait(0.05)
        VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    else
        VIM:SendMouseButtonEvent(0, 0, 1, true, game, 1)
        wait(0.05)
        VIM:SendMouseButtonEvent(0, 0, 1, false, game, 1)
    end

    lastHit = now
    comboStep = (comboStep + 1) % 3
end

-- Авто-уклонение (без перехвата анимаций, анализируем события игры)
local AutoDodge = false
local lastDodge = 0
local dodgeChance = 80 -- процент шанса уклонения

local function tryDodge()
    if not AutoDodge then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = char.HumanoidRootPart

    local now = tick()
    if now - lastDodge < math.random(60, 110)/100 then return end -- от 0.6 до 1.1 сек задержки

    -- Проверяем, атакует ли нас кто-то вблизи: просто смотрим, есть ли игрок рядом и его анимация атаки
    local danger = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") then
            local theirHum = plr.Character.Humanoid
            local theirRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if theirRoot and theirHum.Health > 0 and (theirRoot.Position - myRoot.Position).Magnitude < 18 then
                -- Проверяем анимации
                local animator = theirHum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        if track.Animation.AnimationId:lower():find("punch") or track.Animation.AnimationId:lower():find("attack") or track.Animation.AnimationId:lower():find("hit") or track.Animation.AnimationId:lower():find("m1") or track.Animation.AnimationId:lower():find("m2") then
                            danger = true
                            break
                        end
                    end
                end
            end
            if danger then break end
        end
    end

    if danger and math.random(1,100) <= dodgeChance then
        VIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
        wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
        lastDodge = now
    end
end

-- Авто-блок
local AutoBlock = false
local blockKeyDown = false

local function handleBlock()
    if not AutoBlock then
        if blockKeyDown then
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            blockKeyDown = false
        end
        return
    end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        if blockKeyDown then
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            blockKeyDown = false
        end
        return
    end
    local myRoot = char.HumanoidRootPart
    local nearEnemy = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if (plr.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude <= 15 then
                nearEnemy = true
                break
            end
        end
    end
    if nearEnemy and not blockKeyDown then
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        blockKeyDown = true
    elseif not nearEnemy and blockKeyDown then
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        blockKeyDown = false
    end
end

-- ESP
local espEnabled = true
local espList = {}

local function createESP(target)
    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Color = Color3.fromRGB(255, 50, 50)
    box.Filled = false
    box.Visible = false

    local nameTag = Drawing.new("Text")
    nameTag.Size = 13
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Visible = false

    local infoTag = Drawing.new("Text")
    infoTag.Size = 12
    infoTag.Color = Color3.fromRGB(200, 200, 200)
    infoTag.Center = true
    infoTag.Outline = true
    infoTag.Visible = false

    return { target = target, box = box, nameTag = nameTag, infoTag = infoTag }
end

-- Хитбокс-менялка (визуально)
local hitboxMult = 1.0
local function setHitboxSize(mult)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("hitbox") or obj.Name:lower():find("damage") or obj.Name:lower():find("punch")) then
            if not obj:FindFirstChild("OriginalSize") then
                local orig = Instance.new("NumberValue")
                orig.Name = "OriginalSize"
                orig.Value = obj.Size
                orig.Parent = obj
            end
            local orig = obj.OriginalSize.Value
            obj.Size = orig * mult
        end
    end
end

-- ФПС буст
local fpsBoostActive = false
local function applyFPSBoost()
    if fpsBoostActive then
        settings().Rendering.QualityLevel = 1
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 50
        Lighting.Brightness = 1.5
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                obj:Destroy()
            end
        end
    end
end

