    if v then
        spawn(AutoM1Loop)
    end
end)

-- === AUTO PERFECT DODGE ===
local AutoDodge = false
local dodgeDistance = 18
local dodgeCooldown = 0.8 -- минимальная задержка между уклонениями
local lastDodgeTime = 0
local dodgeRandomChance = 0.85 -- шанс 85% идеального уклонения (чтобы не палиться)

local function AutoDodgeLoop()
    while AutoDodge do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local myRoot = char.HumanoidRootPart
            local now = tick()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local theirChar = plr.Character
                    local theirHum = theirChar:FindFirstChild("Humanoid")
                    if theirHum and theirHum.Health > 0 then
                        local animator = theirHum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                local animName = track.Animation.AnimationId:lower()
                                if (animName:find("punch") or animName:find("attack") or animName:find("hit") or animName:find("m1") or animName:find("m2")) and track.Speed > 0 then
                                    local dist = (theirChar.HumanoidRootPart.Position - myRoot.Position).Magnitude
                                    if dist < dodgeDistance and now - lastDodgeTime > dodgeCooldown and math.random() < dodgeRandomChance then
                                        -- Нажимаем Q (уклонение)
                                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                                        wait(0.05)
                                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                                        lastDodgeTime = now
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        wait(0.05)
    end
end

AddToggle("Auto Perfect Dodge", false, function(v)
    AutoDodge = v
    if v then
        spawn(AutoDodgeLoop)
    end
end)

-- === AUTO BLOCK ===
local AutoBlock = false
local function AutoBlockLoop()
    while AutoBlock do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local myRoot = char.HumanoidRootPart
            local nearEnemy = false
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    if (plr.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude <= 15 then
                        nearEnemy = true
                        break
                    end
                end
            end
            -- Зажимаем E (блок)
            if nearEnemy then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            else
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end
        end
        wait(0.2)
    end
end

