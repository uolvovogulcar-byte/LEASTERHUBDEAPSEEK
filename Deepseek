-- === HITBOX VISUAL MULTIPLIER ===
local function SetHitboxMultiplier(mult)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name:lower():find("hitbox") or v.Name:lower():find("damage") or v.Name:lower():find("punch")) then
            -- Сохраняем оригинальный размер? Просто устанавливаем Size с учётом множителя (приблизительно)
            -- Осторожно: не сломаем анимации. Лучше умножать только размеры хитбоксов, но не трогать кости.
            if not v:FindFirstChild("OriginalSize") then
                local orig = Instance.new("NumberValue", v)
                orig.Name = "OriginalSize"
                orig.Value = v.Size
            end
            local orig = v:FindFirstChild("OriginalSize").Value
            v.Size = orig * mult
        end
    end
end

local hitboxMult = 1.0
AddSlider("Hitbox Scale", 0.5, 3.0, 1.0, function(val)
    hitboxMult = val
    SetHitboxMultiplier(val)
end)

-- === ESP ===
local espEnabled = true
local espList = {}

local function createESP(target)
    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Color = Color3.fromRGB(255, 50, 50)
    box.Filled = false
    box.Visible = false

    local nameTag = Drawing.new("Text")
    nameTag.Size = 13
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Visible = false

    local infoTag = Drawing.new("Text")
    infoTag.Size = 12
    infoTag.Color = Color3.fromRGB(200, 200, 200)
    infoTag.Center = true
    infoTag.Outline = true
    infoTag.Visible = false

    return {
        target = target,
        box = box,
        nameTag = nameTag,
        infoTag = infoTag
    }
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then
        for _, e in ipairs(espList) do
            e.box.Visible = false
            e.nameTag.Visible = false
            e.infoTag.Visible = false
        end
        return
    end

    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChild("Humanoid")
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                table.insert(targets, {character = player.Character, hum = hum, root = root, name = player.Name})
            end
        end
    end

    for i, esp in ipairs(espList) do
        if not table.find(targets, esp.target) then
            esp.box:Remove()
            esp.nameTag:Remove()
            esp.infoTag:Remove()
            table.remove(espList, i)
        end
    end

    for _, t in ipairs(targets) do
        local found = false
        for _, esp in ipairs(espList) do
            if esp.target == t then
                found = true
                break
            end
        end
        if not found then
            local newESP = createESP(t)
            table.insert(espList, newESP)
        end
    end

    for _, esp in ipairs(espList) do
        local t = esp.target
        local root = t.root
        local hum = t.hum
        if root and hum and hum.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                local dist = (root.Position - Camera.CFrame.Position).Magnitude
                local scale = 1 / (dist * math.tan(math.rad(Camera.FieldOfView / 2)) * 2)
                local size = Vector2.new(150 * scale, 200 * scale)
                local boxPos = Vector2.new(pos.X - size.X/2, pos.Y - size.Y/2)

                esp.box.Size = size
                esp.box.Position = boxPos
                esp.box.Visible = true

                esp.nameTag.Text = t.name
                esp.nameTag.Position = Vector2.new(pos.X, boxPos.Y - 15)
                esp.nameTag.Visible = true

                local stamina = hum:FindFirstChild("Stamina") or hum:FindFirstChild("StaminaValue")
                local staminaText = stamina and ("Stamina: " .. math.floor(stamina.Value)) or ""
                esp.infoTag.Text = "HP: " .. math.floor(hum.Health) .. " | " .. staminaText .. " | " .. math.floor(dist) .. "m"
                esp.infoTag.Position = Vector2.new(pos.X, boxPos.Y + size.Y + 5)
                esp.infoTag.Visible = true
            else
                esp.box.Visible = false
                esp.nameTag.Visible = false
                esp.infoTag.Visible = false
            end
        else
            esp.box.Visible = false
            esp.nameTag.Visible = false
            esp.infoTag.Visible = false
        end
    end
end)

