-- === AUTO M1 (умное комбо) ===
local AutoM1 = false
local comboStage = 0
local comboCooldown = {0.12, 0.12, 0.3} -- задержки между ударами
local lastHitTime = 0

local function AutoM1Loop()
    while AutoM1 do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local now = tick()
                if now - lastHitTime >= comboCooldown[comboStage + 1] then
                    -- Проверяем, есть ли цель рядом (опционально, иначе просто бьём воздух)
                    local targetNear = false
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                            if (plr.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude <= 15 then
                                targetNear = true
                                break
                            end
                        end
                    end
                    if targetNear then
                        -- Прожимаем нужную кнопку
                        if comboStage == 0 or comboStage == 1 then
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1) -- M1 нажатие
                            wait(0.05)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1) -- M1 отпускание
                        else
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 1) -- M2 нажатие
                            wait(0.05)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 1) -- M2 отпускание
                        end
                        lastHitTime = tick()
                        comboStage = (comboStage + 1) % 3
                    end
                end
            end
        end
        wait(0.05)
    end
end

AddToggle("Auto M1 Combo", false, function(v)
